# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# The Odds API (https://the-odds-api.com/)
ODDS_API_KEY=your_key_here

# API-Football via API-Sports (https://api-sports.io/)
API_FOOTBALL_KEY=your_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io

# CricketData.org (https://cricketdata.org/)
CRICKET_DATA_API_KEY=your_key_here

# Upstash Redis (https://upstash.com/)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Vercel Cron Secret
CRON_SECRET=your_random_secret_here

# --- Client-safe display config (public) ---
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_ODDS_FORMAT=decimal

# --- Server-only authoritative limits (never expose to client) ---
# Initial bankroll seed in EUR. Live authoritative value lives in the `bankroll` table.
BANKROLL_EUR=500
# Hard cap enforced in /api/bets POST. Request rejected if stake exceeds this.
MAX_BET_EUR=10
# Minimum model-vs-book edge to qualify a value bet (0.02 = 2%).
MIN_EDGE=0.02
# Set to "true" only after Phase E backtest criteria are met. Dashboard shows paper-trading banner until then.
BACKTEST_GATE_PASSED=false
