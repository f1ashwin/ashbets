# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# The Odds API (https://the-odds-api.com/)
ODDS_API_KEY=your_key_here

# API-Football via API-Sports (https://api-sports.io/)
API_FOOTBALL_KEY=your_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io

# CricketData.org (https://cricketdata.org/)
CRICKET_DATA_API_KEY=your_key_here

# API-Sports MMA (https://api-sports.io/)
API_MMA_KEY=your_key_here
API_MMA_HOST=v1.mma.api-sports.io

# Exchange API (Phase 6 - Automated Betting)
# MATCHBOOK_USERNAME=
# MATCHBOOK_PASSWORD=
# SMARKETS_API_TOKEN=

# Upstash Redis (https://upstash.com/)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Vercel Cron Secret
CRON_SECRET=your_random_secret_here

# App Config
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_ODDS_FORMAT=decimal
NEXT_PUBLIC_MAX_DAILY_STAKE=5
NEXT_PUBLIC_MAX_SINGLE_BET_PCT=2
