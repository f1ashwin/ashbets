# ----------------------------------------------------------------------------
# AshBets local environment template.
#
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Most are obtained from creating free accounts on the named providers.
# Run `npm run check:env` after filling to verify everything is set.
# ----------------------------------------------------------------------------

# ---- Supabase -------------------------------------------------------------
# Create a project at https://supabase.com (free tier is fine for v1).
# DATABASE_URL is under Project Settings → Database → Connection string → URI.
# The two public keys are under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---- Auth (single-user allowlist) -----------------------------------------
# Sign-in is email + password via Supabase Auth. Provision your user in the
# Supabase dashboard: Authentication → Users → Add user → set an email and
# password. Email confirmation can be disabled in Authentication → Providers
# → Email for single-user bootstrap, or you can mark the user as confirmed
# manually after creating it.
#
# ALLOWED_EMAIL gates the app to one user — any other account that signs in
# is signed out and redirected back to /login. Leave unset in dev to allow
# any Supabase user (useful for first bootstrap).
ALLOWED_EMAIL=you@example.com

# ---- Upstash Redis --------------------------------------------------------
# Create a DB at https://console.upstash.com (free tier is fine).
# Both values are on the DB's "REST API" tab.
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ---- Upstream data APIs ---------------------------------------------------
# The Odds API — https://the-odds-api.com/
# Free tier is 500/mo; Phase A needs the €30/mo Start plan (20k/mo).
ODDS_API_KEY=your_key_here

# API-Football via API-Sports — https://api-sports.io/
API_FOOTBALL_KEY=your_key_here
API_FOOTBALL_HOST=v3.football.api-sports.io

# CricketData.org — https://cricketdata.org/
CRICKET_DATA_API_KEY=your_key_here

# ---- Cron auth ------------------------------------------------------------
# Any random 32+ char string. Used as Bearer token on /api/cron.
CRON_SECRET=your_random_secret_here

# ---- Client-safe display prefs (public, OK to ship to the browser) --------
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_ODDS_FORMAT=decimal

# ---- Server-only authoritative limits (NEVER expose to the client) --------
# See src/lib/config/limits.ts — these drive bet placement, caps, and paper mode.

# Daily total stake cap in currency units (EUR). Default 10.
MAX_DAILY_STAKE_EUR=10

# Soft per-bet cap as fraction of bankroll. Kelly is clamped to this first.
# Default 0.02 (2% of bankroll).
MAX_SINGLE_BET_PCT_SOFT=0.02

# Hard per-bet cap — never exceeded regardless of Kelly recommendation.
# Default 0.05 (5% of bankroll).
MAX_SINGLE_BET_PCT_HARD=0.05

# Correlation-safety discount applied to combo (parlay) probabilities.
# Default 0.07 (7% haircut on combined probability before EV check).
CORRELATION_DISCOUNT=0.07

# Minimum model-vs-book edge to qualify a signal as a value bet. 0.02 = 2%.
# See src/lib/predictions/value-calculator.ts.
MIN_EDGE=0.02

# Set to "true" only after Phase E backtest criteria are met. Until then every
# placed bet gets paperOnly=true and the dashboard shows the paper-mode pill.
BACKTEST_GATE_PASSED=false

# ---- API tier overrides (server-only, optional) ---------------------------
# See src/lib/config/api-budget.ts — the rate limiter and the budget checker
# both read these so raising a paid-tier upgrade lifts both together.

# The Odds API monthly request ceiling. 500 = free tier, 20000 = Start plan.
ODDS_API_MONTHLY_LIMIT=500

# Optional explicit daily override for the Odds API. If unset, derived from
# the monthly limit (monthly / 30).
# ODDS_API_DAILY_LIMIT=16

# API-Football daily cap. 100 = free tier.
API_FOOTBALL_DAILY_LIMIT=100

# CricketData hourly cap. 1000 = free tier, effectively unlimited for v1 needs.
CRICKET_DATA_HOURLY_LIMIT=1000

# FBref scraping self-imposed cap. Not used in v1.
FBREF_PER_MINUTE_LIMIT=10
